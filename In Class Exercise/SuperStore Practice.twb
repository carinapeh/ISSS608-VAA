      <aliases enabled='yes' />
      <column caption='UCL ' datatype='real' name='[Calculation_1620350504275968]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='WINDOW_AVG(SUM([Sales])) + WINDOW_STDEV(SUM([Sales])) * [Parameters].[Parameter 1]'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Out of Control Limit' datatype='real' name='[Calculation_1620350509195266]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Sales]) &gt; [Calculation_1620350504275968]&#10;OR SUM([Sales]) &lt; [UCL  (copy)_1620350507622401]&#10;THEN SUM([Sales])&#10;END'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Gain or Loss' datatype='string' name='[Calculation_1620350512304131]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF {FIXED [Sub-Category]: SUM(IF DATEPART(&apos;year&apos;,&#10;[Order Date]) = 2025 THEN [Sales] END)} &gt; &#10;   {FIXED [Sub-Category]: SUM(IF DATEPART(&apos;year&apos;,&#10;[Order Date]) = 2022 THEN [Sales] END)} &#10;THEN &quot;Gain&quot; ELSE &quot;Loss&quot; END' />
      </column>
      <column caption='Loss' datatype='string' name='[Calculation_1620350514044932]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1620350512304131] = &quot;Loss&quot; THEN [Sub-Category] END' />
      </column>
